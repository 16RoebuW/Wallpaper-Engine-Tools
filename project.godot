; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WallpaperEngineTools"
run/main_scene="uid://bfu6exwk5db5k"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GifManagerWrapper="*uid://bhs8fq5adpglc"
ToolsDataManager="*uid://bl1whs6a77174"
Globals="*uid://bccp4rr2tuam1"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1020
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="WallpaperEngineTools"

[input]

multi_select_modifier={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
